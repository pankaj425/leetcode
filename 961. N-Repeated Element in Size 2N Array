class Solution {
    public int repeatedNTimes(int[] nums) {
        for(int i=0;i<nums.length;i++){
            for(int j=i+1;j<nums.length;j++){
                if(nums[i]==nums[j]){
                    return nums[i];
                }
            }
        }
        return -1;
        
    } 
}



class Solution {
    public int repeatedNTimes(int[] nums) {
        HashSet <Integer> seen = new HashSet<>();
        for(int i=0;i<nums.length;i++){
            if(seen.contains(nums[i])){
                 return nums[i];
            }
            seen.add(nums[i]);
        
       
        }
     return -1;
        
    } 
}
